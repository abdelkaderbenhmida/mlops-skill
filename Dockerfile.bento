# BentoML service container
# Build: docker build -f Dockerfile.bento -t mlops-churn-service .
# Run: docker run -p 3000:3000 mlops-churn-service

FROM python:3.10-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# System deps for onnxruntime, mlflow, etc.
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY src ./src
COPY feature_repo ./feature_repo
COPY pipelines ./pipelines
COPY model_cards ./model_cards
COPY mlops-full-mlops-skills-project.md ./

# Build the Bento service (this bakes the model into the image)
RUN bentoml build src.serving.bento_service:svc --include-models

# The bento is now in ~/.bentoml/bentos/ - we'll serve the latest
EXPOSE 3000

CMD ["bentoml", "serve", "mlops_churn_service:latest", "--host", "0.0.0.0", "--port", "3000"]